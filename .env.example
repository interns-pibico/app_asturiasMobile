# app_asturiasMobile — copy to .env and fill in values
APP_NAME=app_asturiasMobile
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8002

# Security
APP_SECRET_KEY=dev-secret-key-change-in-prod

# Database (shared with app_example — BD asturiasmap)
DATABASE_URL=postgresql+asyncpg://asturiasuser:change-me@localhost:5432/asturiasmap

# Proxy / root path — REQUIRED when served at /mobile/ via nginx
# APP_ROOT_PATH=/mobile   ← uncomment for production

# i18n
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=["es","en"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# AstuGuía chat (optional — leave empty to disable)
CHAT_API_KEY=
CHAT_BASE_URL=https://api.pibico.es/chat
CHAT_NOTEBOOK_ID=
CHAT_PROVIDER=ollama
CHAT_MODEL=mistral-small:24b
